{
  "name": "@youj/motion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "(alpha) Motion components on @youj/core: primitives, transitions, effects, interactions, backgrounds and players.",
  "author": {
    "name": "louis-henry",
    "url": "https://www.youj.dev"
  },
  "license": "MIT",
  "keywords": [
    "alpha",
    "motion",
    "animation",
    "design-tokens",
    "springs",
    "reduced-motion",
    "themes",
    "lottie",
    "webgl",
    "youj",
    "react",
    "accessible",
    "tailwindcss",
    "design-system"
  ],
  "homepage": "https://www.youj.dev/docs/motion",
  "bugs": {
    "url": "https://github.com/youj-dev/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youj-dev/ui.git",
    "directory": "packages/motion"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./interactions": "./src/interactions.ts",
    "./backgrounds": "./src/backgrounds.ts",
    "./players": "./src/players.ts",
    "./*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./interactions": {
        "types": "./dist/interactions.d.ts",
        "default": "./dist/interactions.js"
      },
      "./backgrounds": {
        "types": "./dist/backgrounds.d.ts",
        "default": "./dist/backgrounds.js"
      },
      "./players": {
        "types": "./dist/players.d.ts",
        "default": "./dist/players.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint:tokens": "node ../core/scripts/check-tokens.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "verify": "pnpm typecheck && pnpm lint:tokens && pnpm registry:check && pnpm test"
  },
  "devDependencies": {
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@youj/core": "workspace:*",
    "lucide-react": "^1.59.0",
    "motion": "^13.4.4"
  },
  "peerDependencies": {
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@youj/core": "workspace:*",
    "motion": "^13.4.4 || ^14",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "@lottiefiles/dotlottie-react": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
