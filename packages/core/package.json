{
  "name": "@youj/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "(alpha) The contract every Youj package builds on: motion tokens, YoujProvider and its hooks, themes, labels, cn and the token stylesheet.",
  "author": {
    "name": "louis-henry",
    "url": "https://www.youj.dev"
  },
  "license": "MIT",
  "keywords": [
    "alpha",
    "design-tokens",
    "motion",
    "springs",
    "reduced-motion",
    "themes",
    "youj",
    "react",
    "accessible",
    "tailwindcss",
    "design-system"
  ],
  "homepage": "https://www.youj.dev/docs/theming",
  "bugs": {
    "url": "https://github.com/youj-dev/ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youj-dev/ui.git",
    "directory": "packages/core"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./labels": "./src/labels.ts",
    "./internal": "./src/internal.ts",
    "./locales/*": "./src/locales/*.ts",
    "./*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      },
      "./locales/*": {
        "types": "./dist/locales/*.d.ts",
        "default": "./dist/locales/*.js"
      },
      "./styles.css": "./dist/styles.css",
      "./presets.css": "./dist/presets.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage.enabled",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "labels:generate": "node ../../scripts/generate-labels.mjs",
    "check:labels": "node ../../scripts/generate-labels.mjs --check",
    "verify": "pnpm typecheck && pnpm registry:check && pnpm check:labels && pnpm test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "lucide-react": "^1.59.0",
    "motion": "^13.4.4"
  },
  "peerDependencies": {
    "motion": "^13.4.4 || ^14",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
