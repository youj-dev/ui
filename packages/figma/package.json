{
  "name": "@youj/figma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Figma development plugin that builds the Youj kit (variables, styles, icons, foundations and components) from the real tokens.",
  "author": {
    "name": "louis-henry",
    "url": "https://www.youj.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "blocks": "node scripts/blocks.ts",
    "cover:docs": "COVER_DOCS=1 vitest run test/cover-docs.test.ts",
    "illustrations": "node scripts/illustrations.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.plugin.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "verify": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.139.0",
    "@youj/core": "workspace:*",
    "@youj/icons": "workspace:*",
    "@youj/illustrations": "workspace:*",
    "@youj/react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
