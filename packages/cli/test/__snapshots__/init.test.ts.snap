exports[`init, package mode > sets up astro, and a re-run changes nothing > src/layouts/Layout.astro 1`] = `
"---
import '@fontsource-variable/jetbrains-mono'
import '@fontsource-variable/inter'
import '../styles/global.css'
const { title = 'Astro' } = Astro.props;
---

<!doctype html>
<html lang="en" data-yj-theme="basalt" data-yj-motion="precise" data-yj-look="classic">
	<head>
		<script is:inline>(function(k,d){try{var m=localStorage.getItem(k);if(m!=='light'&&m!=='dark'&&m!=='system')m=d;var s=m==='system'?(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'):m;var e=document.documentElement;e.setAttribute('data-theme',s);e.style.colorScheme=s}catch(e){}})("theme","system")</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
"
`;

