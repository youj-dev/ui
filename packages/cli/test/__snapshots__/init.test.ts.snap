"import {
  isRouteErrorResponse,
  Links,
  Meta,
  Outlet,
  Scripts,
  ScrollRestoration,
} from "react-router";

import type { Route } from "./+types/root";
import "./app.css";
import { YoujProvider, basalt, themeProps } from "@youj/core";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import { ThemeScript } from "@youj/react";

export function Layout({ children }: { children: React.ReactNode }) {
  return (
    <html lang="en" {...themeProps(basalt)} data-yj-look="classic" suppressHydrationWarning>
      <head>
        <ThemeScript />
        <meta charSet="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <Meta />
        <Links />
      </head>
      <body>
        <YoujProvider theme={basalt}>
          {children}
          <ScrollRestoration />
          <Scripts />
        </YoujProvider>
      </body>
    </html>
  );
}

export default function App() {
  return <Outlet />;
}
"
`;

