{
  "name": "@youj/illustrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "(alpha) Isometric illustrations for React: ready-made scenes, the isometric kit they are drawn with (IsoScene, IsoBox, IsoCylinder, IsoStack, the grids, IllustrationStage).",
  "keywords": [
    "alpha",
    "illustrations",
    "isometric",
    "svg",
    "react",
    "empty-states",
    "themes",
    "youj"
  ],
  "homepage": "https://www.youj.dev/docs/illustrations",
  "bugs": {
    "url": "https://github.com/youj-dev/ui/issues"
  },
  "author": {
    "name": "louis-henry",
    "url": "https://www.youj.dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youj-dev/ui.git",
    "directory": "packages/illustrations"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./builder": "./src/builder.ts",
    "./*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled",
    "lint:tokens": "node ../core/scripts/check-tokens.mjs",
    "generate": "node scripts/generate-illustrations.mjs",
    "generate:check": "node scripts/generate-illustrations.mjs --check",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "verify": "pnpm typecheck && pnpm lint:tokens && pnpm generate:check && pnpm registry:check && pnpm test"
  },
  "devDependencies": {
    "@youj/core": "workspace:*",
    "motion": "^13.4.4"
  },
  "peerDependencies": {
    "@youj/core": "workspace:*",
    "motion": "^13.4.4 || ^14",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
