{
  "name": "youj-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "pnpm -r --filter \"./packages/*\" build",
    "clean": "rm -rf storybook-static coverage test-results playwright-report && find apps packages -path '*/node_modules' -prune -o -name .next -type d -prune -print | while read d; do find \"$d\" -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} +; done",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check:imports": "node scripts/check-imports.mjs",
    "labels:generate": "node scripts/generate-labels.mjs",
    "check:labels": "node scripts/generate-labels.mjs --check",
    "check:packages": "node --test --test-reporter=dot scripts/dist-subpaths.test.mjs && node scripts/check-packages.mjs",
    "check:sleeps": "node --test --test-reporter=dot scripts/check-sleeps.test.mjs && node scripts/check-sleeps.mjs",
    "check:tints": "node --test --test-reporter=dot scripts/codemods/token-tints.test.mjs && node scripts/check-tints.mjs",
    "check:api": "node scripts/check-api.mjs",
    "lint:copy-in": "node --test --test-reporter=dot scripts/check-copy-in-lint.test.mjs && node scripts/check-copy-in-lint.mjs",
    "check:affected": "node --test --test-reporter=dot scripts/affected.test.mjs",
    "check:changesets": "node --test --test-reporter=dot scripts/check-changesets.test.mjs scripts/check-changelog.test.mjs && node scripts/check-changesets.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:taxonomy": "node --test --test-reporter=dot scripts/taxonomy.test.mjs && node scripts/taxonomy.mjs",
    "lint:ladder": "node scripts/taxonomy.mjs --ladder",
    "api:update": "node scripts/api-snapshot.mjs && node scripts/surface-snapshot.mjs && pnpm -F @youj/mcp generate && pnpm -F @youj/cli -F @youj/mcp exec vitest run test/surface.test.ts -u",
    "verify": "pnpm lint && pnpm check:imports && pnpm check:labels && pnpm check:affected && pnpm check:changesets && pnpm check:taxonomy && pnpm check:tints && pnpm check:sleeps && pnpm check:api && pnpm lint:copy-in && pnpm -r verify && pnpm check:packages",
    "prestorybook": "pnpm -r --filter \"./packages/*\" registry:build > /dev/null",
    "prebuild-storybook": "pnpm -r --filter \"./packages/*\" registry:build > /dev/null",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "launch:snapshot": "node scripts/launch-snapshot.mjs",
    "launch:verify": "node scripts/verify-launch.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "test:visual": "node scripts/playwright-docker.mjs --project=visual",
    "test:visual:update": "node scripts/playwright-docker.mjs --project=visual --update-snapshots",
    "test:coverage": "pnpm -r --filter \"./packages/*\" test:coverage && node scripts/coverage-summary.mjs",
    "test:stories": "node scripts/test-stories.mjs",
    "test:a11y": "playwright test --project=a11y --project=tone",
    "perf": "node scripts/perf/run.mjs",
    "perf:compare": "node scripts/perf/compare.mjs",
    "smoke": "node scripts/smoke-consumer.mjs",
    "e2e:install": "node scripts/e2e/install.mjs",
    "lint": "biome lint --diagnostic-level=error . && node --test --test-reporter=dot scripts/check-lint.test.mjs && node scripts/check-lint.mjs",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "react": "19.3.0",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.1",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "shell-quote": "^1.11.0",
      "source-map-js": "^1.2.2",
      "undici@7": "^7.29.1",
      "sharp": "^0.35.5",
      "@modelcontextprotocol/sdk": "^1.31.0",
      "yuku-ast": "~0.17.0",
      "yuku-parser": "~0.17.0",
      "yuku-codegen": "~0.17.0",
      "yuku-analyzer": "~0.17.0"
    }
  }
}
