{
  "name": "promo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Youj promo video, posters and social graphics, rendered with Remotion from the real @youj/motion and @youj/react source.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/render.mjs",
    "approve": "node scripts/approve.mjs",
    "cues": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/cues.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "teaser": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/teaser.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@youj/core": "workspace:*",
    "@youj/icons": "workspace:*",
    "@youj/illustrations": "workspace:*",
    "@youj/loaders": "workspace:*",
    "@youj/motion": "workspace:*",
    "@youj/react": "workspace:*",
    "@remotion/cli": "4.0.538",
    "motion": "^13.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/webpack": "4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "css-loader": "^7.1.4",
    "react-hook-form": "^7.89.0",
    "recharts": "3.10.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "zod": "^4.6.5"
  }
}
